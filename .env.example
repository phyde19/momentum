# -----------------------------------------------------------------------------
# Core environment
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=Personal Productivity System
LOG_LEVEL=info
TIMEZONE=UTC

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_DB=productivity
POSTGRES_USER=productivity
POSTGRES_PASSWORD=change_me_strong
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://productivity:change_me_strong@postgres:5432/productivity

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/v1
AUTO_MIGRATE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Auth mode
# - dev: local testing without Cloudflare
# - cloudflare: validate Cloudflare Access JWT assertions
# -----------------------------------------------------------------------------
AUTH_MODE=dev
DEV_AUTH_EMAIL=owner@example.com

# Cloudflare Access (used when AUTH_MODE=cloudflare)
CLOUDFLARE_TEAM_DOMAIN=your-team-name.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUDIENCE=replace_with_access_audience_tag
CLOUDFLARE_TUNNEL_TOKEN=replace_with_tunnel_token

# Future OpenClaw service-token placeholders (phase 2)
CLOUDFLARE_AGENT_CLIENT_ID=replace_with_service_token_client_id
CLOUDFLARE_AGENT_CLIENT_SECRET=replace_with_service_token_client_secret

# -----------------------------------------------------------------------------
# Human web app
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_DEV_USER_EMAIL=owner@example.com

# -----------------------------------------------------------------------------
# Cloudflare routing placeholders (for deployment docs/scripts)
# -----------------------------------------------------------------------------
BASE_DOMAIN=example.com
TASKS_WEB_DEV_DOMAIN=tasks-dev.example.com
TASKS_API_DEV_DOMAIN=tasks-api-dev.example.com
TASKS_WEB_DOMAIN=tasks.example.com
TASKS_API_DOMAIN=tasks-api.example.com

# -----------------------------------------------------------------------------
# Backup to Cloudflare R2 (S3-compatible)
# -----------------------------------------------------------------------------
BACKUP_S3_BUCKET=productivity-backups
BACKUP_S3_PREFIX=postgres
BACKUP_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
BACKUP_AWS_REGION=auto
BACKUP_RETENTION_DAYS=14
# Optional encryption passphrase (recommended)
BACKUP_ENCRYPTION_PASSPHRASE=change_me
